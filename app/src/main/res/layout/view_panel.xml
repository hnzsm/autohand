<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="252dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPrevScript"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="◀"
            android:textColor="@color/panel_text" />

        <TextView
            android:id="@+id/panelScriptName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/panel_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNextScript"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/panel_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/panelState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/panel_text_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/panel_record"
            android:textColor="@color/panel_text" />

        <TextView
            android:id="@+id/btnRun"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/panel_start"
            android:textColor="@color/accent"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/panel_stop"
            android:textColor="@color/panel_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="循环次数"
            android:textColor="@color/panel_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnLoopMinus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/panel_text" />

        <TextView
            android:id="@+id/valueLoop"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/panel_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnLoopPlus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/panel_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="每轮间隔"
            android:textColor="@color/panel_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnGapMinus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/panel_text" />

        <TextView
            android:id="@+id/valueGap"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/panel_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnGapPlus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/panel_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="随机抖动"
            android:textColor="@color/panel_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnJitterMinus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/panel_text" />

        <TextView
            android:id="@+id/valueJitter"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/panel_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnJitterPlus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/panel_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="每轮随机抽一段"
            android:textColor="@color/panel_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnRandomPick"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:textColor="@color/panel_text"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnHidePanel"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:text="收起"
        android:textColor="@color/panel_text_dim"
        android:textSize="13sp" />
</LinearLayout>
