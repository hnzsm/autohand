<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.quqi.autohand.ui.TrailView
        android:id="@+id/trail"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/recordHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_record_hint"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/record_hint"
        android:textColor="@color/panel_text"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/recordBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_panel"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/btnRecordCancel"
            android:layout_width="72dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/record_cancel"
            android:textColor="@color/panel_text" />

        <TextView
            android:id="@+id/btnRecordAgain"
            android:layout_width="88dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/record_again"
            android:textColor="@color/panel_text" />

        <TextView
            android:id="@+id/btnRecordSave"
            android:layout_width="96dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/record_save"
            android:textColor="@color/accent"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
